{
    "name": "theme-alchemortis",
    "version": "2.25.1",
    "displayName": "Alchemortis Theme",
    "homepage": "https://github.com/macielvini/alchemortis-vs-code-theme",
    "description": "Alchemortis: a dark theme for Visual Studio Code, forked from Dracula. 🦇",
    "publisher": "macielvini",
    "license": "MIT",
    "scripts": {
        "build": "node ./scripts/build.js",
        "lint": "node ./scripts/lint.js",
        "package": "vsce package -o ./bin/dracula.vsix",
        "vscode:prepublish": "npm run build",
        "vsce-publish": "vsce publish"
    },
    "maintainers": [
        "Derek Sifford",
        "Lucas de França (luxonauta)",
        "Zeno Rocha"
    ],
    "contributors": [
        "Krzysztof Wisznarewski",
        "Daniel Ramos",
        "Eric Jackson",
        "Elliott Pogue",
        "Ajit Singh",
        "Teddy Bradford"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/macielvini/alchemortis-vs-code-theme.git"
    },
    "bugs": {
        "url": "https://github.com/macielvini/alchemortis-vs-code-theme/issues"
    },
    "engines": {
        "vscode": "^1.13.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "dracula",
        "dark",
        "theme",
        "color-theme"
    ],
    "icon": "icon.png",
    "galleryBanner": {
        "color": "#3c4557",
        "theme": "dark"
    },
    "contributes": {
        "themes": [
            {
                "label": "Alchemortis",
                "uiTheme": "vs-dark",
                "path": "./theme/dracula.json"
            },
            {
                "label": "Alchemortis Soft",
                "uiTheme": "vs-dark",
                "path": "./theme/dracula-soft.json"
            }
        ]
    },
    "devDependencies": {
        "js-yaml": "^4.3.2",
        "prettier": "^3.0.0",
        "tinycolor2": "^1.6.0",
        "vsce": "^2.15.0"
    },
    "__metadata": {
        "id": "4e44877c-1c8d-4f9c-ba86-1372d0fbeeb1",
        "publisherDisplayName": "macielvini",
        "publisherId": "fbb3d024-f8f2-460c-bdb5-99552f6d8c4b"
    }
